# ==========================================
# Ollama Chatbot - Backend Environment Configuration
# ==========================================

# Port the Express server listens on
PORT=3000
NODE_ENV=development

# Ollama local endpoint and model names
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=nemotron-mini:latest
READING_MODEL=nemotron-3-nano:4b

# CORS Approved Origins
# Comma-separated list of allowed origins.
# Include localhost ports for dev, your ngrok domain, and your Cloudflare Pages domain (*.pages.dev allowed)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://steadfast-luminance-praying.ngrok-free.dev

# Rate Limiting Protection (per IP window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
